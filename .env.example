# Keycloak (OIDC) — this app is registered as the "spyglass" client
KEYCLOAK_ISSUER=https://auth.piratskastranka.si/auth/realms/mladipirati
KEYCLOAK_CLIENT_ID=spyglass
KEYCLOAK_CLIENT_SECRET=

# Helm API — provides user data and validates application access
HELM_API_URL=http://localhost:3000

# Auth.js
# Generate a secret with: bunx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3003

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5439/spyglass

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spyglass

# S3 storage config
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
S3_ENDPOINT=https://s3.mladipirati.si
S3_BUCKET=

# Server-to-server access to Helm's internal Spyglass API
SPYGLASS_HELM_SHARED_SECRET=

# Host port for docker-compose.prod.yaml (bound to 127.0.0.1)
APP_PORT=3003
